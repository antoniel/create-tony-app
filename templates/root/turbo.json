{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["PGLITE_DATA_DIR", "PORT", "VITE_API_URL"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
